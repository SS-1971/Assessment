{
	"name": "TransformRawData",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_ADLS_Raw_Json",
						"type": "DatasetReference"
					},
					"name": "RawData"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "sinkForStoringOrders"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "sinkForStoringProducts"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "SinkForStoringOrderProducts"
				}
			],
			"transformations": [
				{
					"name": "CartFlatten"
				},
				{
					"name": "ProductFlatten"
				},
				{
					"name": "alterRowForProducts"
				},
				{
					"name": "alterRowForOrders"
				},
				{
					"name": "alterRowForOrderProducts"
				},
				{
					"name": "ProdAggregate"
				},
				{
					"name": "orderProdAggregate"
				},
				{
					"name": "orderFilter"
				},
				{
					"name": "prodFilter"
				}
			],
			"scriptLines": [
				"parameters{",
				"     order_id as integer,",
				"     product_id as integer",
				"}",
				"source(output(",
				"          carts as (id as integer, products as (id as integer, title as string, price as double, quantity as integer, total as double, discountPercentage as double, discountedTotal as double, thumbnail as string)[], total as double, discountedTotal as double, userId as integer, totalProducts as integer, totalQuantity as integer)[],",
				"          total as integer,",
				"          skip as integer,",
				"          limit as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> RawData",
				"RawData foldDown(unroll(carts),",
				"     mapColumn(",
				"          order_id = carts.id,",
				"          total_amount = carts.total,",
				"          discounted_total = carts.discountedTotal,",
				"          customer_id = carts.userId,",
				"          total_products = carts.totalProducts,",
				"          total_qty = carts.totalQuantity,",
				"          products = carts.products",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> CartFlatten",
				"CartFlatten foldDown(unroll(products),",
				"     mapColumn(",
				"          product_id = products.id,",
				"          product_title = products.title,",
				"          product_price = products.price,",
				"          product_quantity = products.quantity,",
				"          product_total = products.total,",
				"          product_discountPercentage = products.discountPercentage,",
				"          product_discountedTotal = products.discountedTotal,",
				"          product_thumbnail = products.thumbnail,",
				"          order_id,",
				"          order_total_amount = total_amount,",
				"          order_discounted_total = discounted_total,",
				"          order_total_qty = total_qty",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> ProductFlatten",
				"ProdAggregate alterRow(upsertIf(true())) ~> alterRowForProducts",
				"orderFilter alterRow(upsertIf(true())) ~> alterRowForOrders",
				"orderProdAggregate alterRow(upsertIf(true())) ~> alterRowForOrderProducts",
				"prodFilter aggregate(groupBy(product_id),",
				"     product_title = first(product_title),",
				"          product_price = first(product_price),",
				"          product_quantity = first(product_quantity),",
				"          product_total = first(product_total),",
				"          product_discountPercentage = first(product_discountPercentage),",
				"          product_thumbnail = first(product_thumbnail)) ~> ProdAggregate",
				"ProductFlatten aggregate(groupBy(product_id,",
				"          order_id),",
				"     order_total_amount = first(order_total_amount),",
				"          order_discounted_total = first(order_discounted_total),",
				"          order_total_qty = first(order_total_qty)) ~> orderProdAggregate",
				"CartFlatten filter(order_id > $order_id) ~> orderFilter",
				"ProductFlatten filter(product_id > $product_id) ~> prodFilter",
				"alterRowForOrders sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['order_id'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          order_id,",
				"          total_amount,",
				"          discounted_total,",
				"          customer_id,",
				"          total_products,",
				"          total_qty",
				"     )) ~> sinkForStoringOrders",
				"alterRowForProducts sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:true,",
				"     upsertable:true,",
				"     keys:['product_id'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          product_id,",
				"          product_name = product_title,",
				"          price = product_price,",
				"          thumbnail = product_thumbnail",
				"     )) ~> sinkForStoringProducts",
				"alterRowForOrderProducts sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['order_id','product_id'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          order_id,",
				"          quantity = order_total_qty,",
				"          total_amount = order_total_amount,",
				"          discounted_total = order_discounted_total,",
				"          product_id",
				"     )) ~> SinkForStoringOrderProducts"
			]
		}
	}
}